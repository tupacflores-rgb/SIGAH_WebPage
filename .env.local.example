####################################################################
#  SIGAH — Variables LOCALES de esta computadora
#  ------------------------------------------------------------------
#  Copiá este archivo como  .env.local  si necesitás valores distintos
#  a los del .env. Se carga DESPUÉS del .env y pisa lo que repita.
#
#  Solo hace falta escribir las claves que querés cambiar.
####################################################################

# Ejemplo: en mi XAMPP el proyecto está en C:\xampp\htdocs\sigah
# BASE_PATH="/sigah"
# APP_URL="http://localhost/sigah"

# Ejemplo: mi MySQL de XAMPP tiene contraseña en root
# DB_ENABLED=true
# DB_USER="root"
# DB_PASS="mi-clave"

# Ejemplo: quiero ver todos los errores mientras desarrollo
# APP_DEBUG=true
