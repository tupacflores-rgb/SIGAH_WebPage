####################################################################
#  SIGAH — Variables de entorno
#  ------------------------------------------------------------------
#  Copiá este archivo como  .env  y ajustá los valores.
#
#  .env        → variables GLOBALES del proyecto (todas las páginas)
#  .env.local  → variables LOCALES de esta computadora; se cargan
#                DESPUÉS del .env y pisan cualquier valor repetido.
#                No se versiona nunca (ver .gitignore).
#
#  En el código se leen con:   env('APP_NAME')
####################################################################


# ==================================================================
#  1. APLICACIÓN (global)
# ==================================================================
APP_NAME="SIGAH"
APP_TAGLINE="Sistema Integral de Gestión de Asistencias y Horarios"
APP_VERSION="1.0.0"
APP_LOCALE="es"

# local | production  — cambia el comportamiento de errores y demos
APP_ENV="local"

# true muestra los errores de PHP en pantalla. En producción: false
APP_DEBUG=true

APP_TIMEZONE="America/Argentina/Salta"

# Tema por defecto si el visitante nunca eligió: light | dark
DEFAULT_THEME="light"


# ==================================================================
#  2. RUTAS / URL (local — depende de dónde lo copiaste en htdocs)
# ==================================================================
# Dejalo VACÍO y SIGAH detecta solo la carpeta.
#   C:\xampp\htdocs\sigah   →  http://localhost/sigah
#   C:\xampp\htdocs         →  http://localhost
# Completalo solo si usás un Alias o VirtualHost raro. Ej: BASE_PATH="/sigah"
BASE_PATH=""

# Solo informativo (se muestra en Configuración → Acerca de)
APP_URL="http://localhost/sigah"


# ==================================================================
#  3. INSTITUCIÓN (global — header, footer y páginas)
# ==================================================================
SCHOOL_NAME="EET N°3100 Rep. de la India"
SCHOOL_SHORT="EET N°3100"
SCHOOL_CITY="Salta"
SCHOOL_PROVINCE="Salta"
SCHOOL_EMAIL="sigah@eet3100.edu.ar"
SCHOOL_PHONE="+54 387 000-0000"
SUPPORT_EMAIL="pixelfix@email.com"
SUPPORT_BRAND="Pixel Fix"


# ==================================================================
#  4. SESIÓN
# ==================================================================
SESSION_NAME="SIGAH_SESSION"
# Duración de la sesión en minutos
SESSION_LIFETIME=120


# ==================================================================
#  5. FUNCIONALIDADES (se prenden y apagan sin tocar el código)
# ==================================================================
# Botón "Entrar como prueba" en el login
ALLOW_DEMO_LOGIN=true

# Permitir que cualquiera cree su usuario desde add-user.php
ALLOW_SELF_REGISTER=true

# Los alert() de bienvenida del proyecto original
SHOW_WELCOME_ALERT=false

# Porcentaje de asistencia por debajo del cual un alumno queda "en riesgo"
ATTENDANCE_RISK_THRESHOLD=85


# ==================================================================
#  6. BASE DE DATOS — MariaDB de XAMPP (opcional)
# ==================================================================
# false → SIGAH usa los archivos JSON de data/ (funciona sin configurar nada)
# true  → usa MariaDB; antes importá sql/sigah.sql desde phpMyAdmin
DB_ENABLED=false
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="sigah"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"


# ==================================================================
#  7. RECURSOS EXTERNOS
# ==================================================================
CDN_FONTAWESOME="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
